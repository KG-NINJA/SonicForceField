{
  "name": "sonic-forcefield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local ultrasonic Doppler motion detector",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check src/dsp.js && node --check src/audio.js && node --check src/app.js && node --check src/scene.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "build": "node scripts/build.js",
    "build:pages": "node scripts/build-pages.js",
    "pretypecheck": "npm run build:pages"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.0",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  }
}
